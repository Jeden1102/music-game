# MySQL (domyślnie)
DATABASE_URL="mysql://UZYTKOWNIK:HASLO@HOST:3306/NAZWA_BAZY"

# SQLite (fallback offline)
# DATABASE_URL="file:./dev.db"

# Sekret do widoku /admin/insert-songs
ADMIN_SECRET="wygeneruj-losowy-sekret"

# YouTube Data API v3 — opcjonalne, ale wymagane do wyszukiwania nowych utworów.
# Klucz zostaje wyłącznie na serwerze (runtimeConfig prywatny).
NUXT_YOUTUBE_API_KEY="twoj-klucz-youtube-data-api-v3"
# Region używany do sprawdzania dostępności filmów (domyślnie PL).
NUXT_YOUTUBE_REGION_CODE="PL"
